# Default profile: no external services required.
APP_PROFILE=demo

# Transitional Demo selectors. The v0.6 target does not add or extend auth,
# profile, catalog-DB, pgvector, or engagement capabilities. Active v0.7 config
# fixes catalog/search to fixture/local and uses only selector/Run/Trace below.
AUTH_ADAPTER=demo
CATALOG_ADAPTER=fixture
SEARCH_ADAPTER=local
ENGAGEMENT_STORE=memory

# Active v0.7 optional adapter selectors.
SELECTOR_ADAPTER=deterministic
RUN_STORE=memory
TRACE_STORE=memory

# Only required when the matching optional adapter is selected. Values belong
# in a private .env.local or secret store, never this template.
# DATABASE_URL=
# DIRECT_URL=
# OPENAI_API_KEY=
# OPENAI_GENERATION_MODEL=

# Deprecated transition-only Live names; not active v0.6 capabilities.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=1536
