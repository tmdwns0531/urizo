# Profile preset. Demo requires no external credentials.
# live => prisma catalog + pgvector + OpenAI selector + Prisma Run/Trace.
APP_PROFILE=demo

# Optional capability overrides. Leave blank to use the selected profile preset.
CATALOG_ADAPTER=
SEARCH_ADAPTER=
SELECTOR_ADAPTER=
RUN_STORE=
TRACE_STORE=

# Supabase PostgreSQL / Prisma. DATABASE_URL is runtime; DIRECT_URL is migration.
DATABASE_URL=
DIRECT_URL=

# Account session signing key. REQUIRED when APP_PROFILE=live — live refuses to
# start without it rather than sign sessions with a shared default anyone could
# read from this repository. Demo generates a throwaway key per process, so
# leave this blank for demo. Each developer picks their own value; sessions do
# not need to be portable between machines. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# OpenAI. Required only by selected embedding/selector/curator adapters.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# TMDB catalog ingestion only. Recommendation requests never call TMDB.
TMDB_API_KEY=
TMDB_LANGUAGE=ko-KR
TMDB_REGION=KR
TMDB_INGEST_PAGES=1

# Operator-only embedding batch limits.
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_BATCHES=20
