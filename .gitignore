# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.*.log
.codex-gh-auth.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare local secrets. Commit only a deliberately redacted example.
/.dev.vars*
!/.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Prisma custom clients are generated after npm ci with npm run db:generate.
# They include machine-specific generator metadata and are not source files.
/src/generated/prisma-workerd/
/src/generated/prisma-node/
