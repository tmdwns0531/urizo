{
  "name": "ott-damoa-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:live": "node scripts/prisma-generate.mjs && node scripts/run-live-dev.mjs",
    "postinstall": "node scripts/prisma-generate.mjs",
    "prebuild": "node scripts/prisma-generate.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern src/generated",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:validate": "node scripts/prisma-validate.mjs",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "live:catalog:ingest": "node --env-file-if-exists=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/live-ingest-tmdb.ts",
    "live:catalog:refresh": "node --env-file-if-exists=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/live-refresh-catalog.ts",
    "live:catalog:embed": "node --env-file-if-exists=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/live-embed-catalog.ts",
    "live:prepare": "npm run db:migrate:deploy && npm run live:catalog:ingest && npm run live:catalog:embed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jiti": "2.7.0",
    "prisma": "6.19.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}