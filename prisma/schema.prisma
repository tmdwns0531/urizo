generator workerdClient {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma-workerd"
  runtime                = "workerd"
  engineType             = "client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

generator nodeClient {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma-node"
  runtime                = "nodejs"
  engineType             = "client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// v0.6/v0.7 persistence baseline. The credential-free Demo continues to use
// memory repositories and must not initialize Prisma.

enum RecommendationRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum RecommendationExecutionMode {
  DETERMINISTIC
  OPENAI
  FALLBACK
}

enum TraceVisibility {
  INTERNAL
  PUBLIC
}

enum TraceAction {
  filter
  vector_search
  score
  select
  policy_block
  approval_request
  approval_decision
  fallback
  replacement
  complete
}

enum CatalogMediaType {
  MOVIE
  SERIES
}

enum CatalogAgeRating {
  ALL
  SEVEN @map("7")
  TWELVE @map("12")
  FIFTEEN @map("15")
  EIGHTEEN @map("18")
  UNKNOWN
}

enum CatalogProvider {
  NETFLIX
  TVING
  DISNEY_PLUS
  WAVVE
  WATCHA
  COUPANG_PLAY
}

enum CatalogProviderLinkType {
  DIRECT
  SEARCH
  HOME
}

model RecommendationRun {
  id                 String                      @id @db.VarChar(64)
  status             RecommendationRunStatus     @default(RUNNING)
  revision           Int                         @default(0)
  nextTraceSequence  Int                         @default(1) @map("next_trace_sequence")
  executionMode      RecommendationExecutionMode? @map("execution_mode")
  inputFingerprint   String?                     @map("input_fingerprint") @db.VarChar(71)
  requestSnapshot    Json                        @map("request_snapshot")
  queryVector        Json?                       @map("query_vector")
  responseSnapshot   Json?                       @map("response_snapshot")
  excludedContentIds String[]                    @default([]) @map("excluded_content_ids")
  replacedContentIds String[]                    @default([]) @map("replaced_content_ids")
  candidateCount     Int                         @default(0) @map("candidate_count")
  resultCount        Int                         @default(0) @map("result_count")
  modelCallCount     Int                         @default(0) @map("model_call_count")
  toolCallCount      Int                         @default(0) @map("tool_call_count")
  totalTokens        Int                         @default(0) @map("total_tokens")
  durationMs         Int                         @default(0) @map("duration_ms")
  policyBlockCount   Int                         @default(0) @map("policy_block_count")
  fallbackReason     String?                     @map("fallback_reason") @db.VarChar(32)
  errorCode          String?                     @map("error_code") @db.VarChar(32)
  startedAt          DateTime                    @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                   @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  traces AgentTrace[]

  @@index([status, createdAt], map: "recommendation_runs_status_created_idx")
  @@index([inputFingerprint], map: "recommendation_runs_fingerprint_idx")
  @@map("recommendation_runs")
}

model AgentTrace {
  id            String          @id @db.VarChar(64)
  runId         String          @map("run_id") @db.VarChar(64)
  sequence      Int
  action        TraceAction
  visibility    TraceVisibility
  detail        Json
  publicMessage String?         @map("public_message") @db.Text
  durationMs    Int?            @map("duration_ms")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  run RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "agent_traces_run_sequence_key")
  @@index([runId, visibility, sequence], map: "agent_traces_run_visibility_idx")
  @@map("agent_traces")
}

model CatalogContent {
  id                  String           @id @db.VarChar(64)
  tmdbId              Int              @map("tmdb_id")
  mediaType           CatalogMediaType @map("media_type")
  title               String           @db.Text
  synopsis            String           @db.Text
  runtimeMinutes      Int              @map("runtime_minutes")
  releaseYear         Int              @map("release_year")
  genres              String[]         @default([])
  moodTags            String[]         @default([]) @map("mood_tags")
  companionTags       String[]         @default([]) @map("companion_tags")
  ageRating           CatalogAgeRating @default(UNKNOWN) @map("age_rating")
  originCountries     String[]         @default([]) @map("origin_countries")
  productionCountries String[]         @default([]) @map("production_countries")
  collectionId        String?          @map("collection_id") @db.VarChar(64)
  voteAverage         Float            @default(0) @map("vote_average") @db.DoublePrecision
  voteCount           Int              @default(0) @map("vote_count")
  posterUrl           String?          @map("poster_url") @db.Text
  backdropColor       String           @map("backdrop_color") @db.VarChar(16)
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  providers       ProviderAvailability[]
  searchDocuments ContentSearchDocument[]

  @@unique([tmdbId, mediaType], map: "catalog_contents_tmdb_media_key")
  @@index([isActive, mediaType], map: "catalog_contents_active_media_idx")
  @@map("catalog_contents")
}

model ProviderAvailability {
  contentId String                  @map("content_id") @db.VarChar(64)
  provider  CatalogProvider
  watchUrl  String                  @map("watch_url") @db.Text
  linkType  CatalogProviderLinkType @map("link_type")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  content CatalogContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([contentId, provider], map: "provider_availabilities_pkey")
  @@index([provider, contentId], map: "provider_availabilities_provider_content_idx")
  @@map("provider_availabilities")
}

model ContentSearchDocument {
  id           String   @id @db.VarChar(64)
  contentId    String   @map("content_id") @db.VarChar(64)
  locale       String   @default("ko-KR") @db.VarChar(16)
  documentText String   @map("document_text") @db.Text
  contentHash  String   @map("content_hash") @db.Char(64)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  content    CatalogContent    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  embeddings ContentEmbedding[]

  @@unique([contentId, contentHash], map: "content_search_documents_content_hash_key")
  @@index([contentId, isActive], map: "content_search_documents_content_active_idx")
  @@map("content_search_documents")
}

model ContentEmbedding {
  id               String                      @id @db.VarChar(64)
  searchDocumentId String                      @map("search_document_id") @db.VarChar(64)
  model            String                      @db.VarChar(64)
  dimensions       Int                         @default(1536)
  embedding        Unsupported("vector(1536)")
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  searchDocument ContentSearchDocument @relation(fields: [searchDocumentId], references: [id], onDelete: Cascade)

  @@unique([searchDocumentId, model], map: "content_embeddings_document_model_key")
  @@index([searchDocumentId], map: "content_embeddings_document_idx")
  @@map("content_embeddings")
}
