generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// v0.6/v0.7 persistence baseline. The credential-free Demo continues to use
// memory repositories and must not initialize Prisma.

enum RecommendationRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum RecommendationExecutionMode {
  DETERMINISTIC
  OPENAI
  FALLBACK
}

enum TraceVisibility {
  INTERNAL
  PUBLIC
}

enum TraceAction {
  filter
  vector_search
  score
  select
  policy_block
  approval_request
  approval_decision
  fallback
  replacement
  complete
}

model RecommendationRun {
  id                 String                      @id @db.VarChar(64)
  status             RecommendationRunStatus     @default(RUNNING)
  revision           Int                         @default(0)
  executionMode      RecommendationExecutionMode @default(DETERMINISTIC) @map("execution_mode")
  inputFingerprint   String                      @map("input_fingerprint") @db.VarChar(71)
  requestSnapshot    Json                        @map("request_snapshot")
  queryVector        Json                        @map("query_vector")
  responseSnapshot   Json?                       @map("response_snapshot")
  excludedContentIds String[]                    @default([]) @map("excluded_content_ids")
  replacedContentIds String[]                    @default([]) @map("replaced_content_ids")
  candidateCount     Int                         @default(0) @map("candidate_count")
  resultCount        Int                         @default(0) @map("result_count")
  modelCallCount     Int                         @default(0) @map("model_call_count")
  toolCallCount      Int                         @default(0) @map("tool_call_count")
  totalTokens        Int                         @default(0) @map("total_tokens")
  durationMs         Int                         @default(0) @map("duration_ms")
  policyBlockCount   Int                         @default(0) @map("policy_block_count")
  fallbackReason     String?                     @map("fallback_reason") @db.VarChar(32)
  errorCode          String?                     @map("error_code") @db.VarChar(32)
  startedAt          DateTime                    @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                   @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  traces AgentTrace[]

  @@index([status, createdAt], map: "recommendation_runs_status_created_idx")
  @@index([inputFingerprint], map: "recommendation_runs_fingerprint_idx")
  @@map("recommendation_runs")
}

model AgentTrace {
  id            String          @id @db.VarChar(64)
  runId         String          @map("run_id") @db.VarChar(64)
  sequence      Int
  action        TraceAction
  visibility    TraceVisibility
  detail        Json
  publicMessage String?         @map("public_message") @db.Text
  durationMs    Int?            @map("duration_ms")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  run RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "agent_traces_run_sequence_key")
  @@index([runId, visibility, sequence], map: "agent_traces_run_visibility_idx")
  @@map("agent_traces")
}
